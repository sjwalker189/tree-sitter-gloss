#!/usr/bin/env bash
#
# Parse every real Gloss file in the compiler repo and fail if any of them produces an ERROR.
#
# This is the check that matters, and it is the one the previous grammar did not have. That
# grammar drifted until it described a *different language* — `use "module"` where the
# compiler had grown `package`/`import`, lowercase `int` where the compiler had `Int` — and
# nothing said so, because its corpus tested it against itself. A corpus can only tell you the
# grammar still agrees with what you wrote down; only the compiler's own files can tell you it
# still agrees with the language.
#
# The examples are a good oracle for exactly the reason they exist: every one is executed by
# the compiler's test suite, so they cannot rot into something the compiler would reject.
#
# Usage:  script/check-against-compiler [path-to-gloss-lang]

set -uo pipefail

repo="${1:-../gloss-lang}"

if [ ! -d "$repo/examples" ]; then
  echo "no compiler repo at '$repo'" >&2
  echo "usage: $0 [path-to-gloss-lang]" >&2
  exit 2
fi

# The one file that is *meant* not to parse. `errors/11-syntax.gloss` documents what a parse
# error does to everything after it — `let x = 1` with no semicolon — so a clean parse of it
# would mean this grammar had grown an automatic-semicolon rule the language deliberately does
# not have. It is checked for the opposite outcome rather than skipped.
expected_to_fail="errors/11-syntax.gloss"

pass=0
fail=0
failures=()
unexpected_pass=""

while IFS= read -r file; do
  relative="${file#"$repo"/examples/}"

  # Captured rather than piped into `grep -q`. With `pipefail` set, a quiet grep exits the
  # moment it matches, `tree-sitter` takes a SIGPIPE, and the pipeline reports failure
  # *because* the match succeeded — which reads as "this file is fine" and is the exact
  # opposite of what happened.
  output="$(tree-sitter parse "$file" 2>/dev/null || true)"

  # Both patterns, and that matters: tree-sitter reports an unterminated construct as
  # `MISSING` rather than `ERROR`, so looking only for the latter passes a file with a hole in
  # it. That is how a missing semicolon went unnoticed the first time this was written.
  if printf '%s' "$output" | grep -qE '\(ERROR|\(MISSING'; then
    if [ "$relative" = "$expected_to_fail" ]; then
      pass=$((pass + 1))
    else
      fail=$((fail + 1))
      failures+=("$file")
    fi
  elif [ "$relative" = "$expected_to_fail" ]; then
    unexpected_pass="$file"
    fail=$((fail + 1))
  else
    pass=$((pass + 1))
  fi
done < <(find "$repo/examples" "$repo/crates/gloss-base/core" -name '*.gloss' | sort)

echo "parsed $((pass + fail)) files from $repo"
echo "  ok:     $pass"
echo "  failed: $fail"

if [ -n "$unexpected_pass" ]; then
  echo
  echo "$expected_to_fail parsed cleanly, and it must not:"
  echo "  it is the language's parse-error example, so accepting it means this grammar"
  echo "  has grown a rule the language does not have."
fi

if [ ${#failures[@]} -gt 0 ]; then
  echo
  echo "these no longer parse:"
  for f in "${failures[@]}"; do
    echo "  ${f#"$repo"/}"
    tree-sitter parse "$f" 2>/dev/null | grep -m1 -oE '\((ERROR|MISSING)[^]]*\]' | sed 's/^/      /'
  done
fi

if [ "$fail" -gt 0 ]; then
  echo
  echo "Either the language grew and this grammar has not, or the grammar is wrong."
  echo "The compiler is the authority: crates/gloss-syntax/src/{kind.rs,parser.rs}."
  exit 1
fi

# The error examples are *meant* not to compile, and are parsed above anyway: almost all of
# them are rejected by the type checker rather than by the parser, so the syntax is valid and
# this grammar should accept it. An editor that stops highlighting a file because it will not
# compile is an editor doing the wrong thing.
echo
echo "all good — including the error examples, which are rejected after parsing, not during it"
